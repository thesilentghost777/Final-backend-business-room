NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_room?schema=public"

JWT_SECRET=change-me-super-long-random-string-64-chars-minimum
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-another-random-string
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web Config (utilisé côté client mobile / web pour Google / Apple sign-in)
# Ces valeurs sont publiques (safe à embarquer côté client). Reproduites ici pour référence.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=tfs-app-90800.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=tfs-app-90800
FIREBASE_WEB_STORAGE_BUCKET=tfs-app-90800.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=255260256264
FIREBASE_WEB_APP_ID=1:255260256264:web:94416c46253d3e00b189bd

# MoneyFusion (fournisseur PayIn / PayOut mobile money)
# URL personnalisée obtenue depuis le tableau de bord MoneyFusion
MONEY_FUSION_API_URL=
MONEY_FUSION_STATUS_URL=https://www.pay.moneyfusion.net/paiementNotif
MONEY_FUSION_RETURN_URL=http://localhost:3000/api/v1/wallet/topup/return
MONEY_FUSION_WEBHOOK_URL=http://localhost:3000/api/v1/wallet/webhook/moneyfusion
# Secret partagé pour restreindre l'accès au webhook (optionnel, recommandé en prod)
MONEY_FUSION_WEBHOOK_SECRET=

MEMBERSHIP_FEE_XOF=10000
DAILY_SAVINGS_MULTIPLE=1200
WEEKLY_SAVINGS_MULTIPLE=6100
BLOCKED_SAVINGS_BONUS_PCT=25
BLOCKED_SAVINGS_DAYS=365
LOAN_INTEREST_PCT=5
LOAN_INSURANCE_PCT=6.5
LOAN_REFERRAL_UNIT_XOF=50000
MARKETPLACE_DAILY_FEATURED=3

THROTTLE_TTL=60
THROTTLE_LIMIT=100
